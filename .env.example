# =============================================================
# CareFlow — copy to .env and fill in. NEVER commit .env
# See docs/API_KEYS.md for where each credential comes from,
# and docs/15-ai-stack.md for why each provider was chosen.
# =============================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---- core services ----
GATEWAY_PORT=4000
AI_SERVICE_URL=http://localhost:8001
DOCAI_SERVICE_URL=http://localhost:8002
TERMINOLOGY_SERVICE_URL=http://localhost:8003
PUBLIC_WEB_URL=http://localhost:3000
# Extra browser origins allowed by the gateway; 3020 serves doctorwebapp/ (python3 -m http.server 3020)
CORS_ORIGINS=http://localhost:3020

# ---- apps/console (staff app, port 3001) ----
# Server-side only — the browser talks to apps/console's own /api/* routes, which proxy
# through @careflow/api-client to the gateway. Never exposed as NEXT_PUBLIC_*.
GATEWAY_URL=http://localhost:4000

# ---- apps/intake (patient app, port 3000) ----
# Unlike console, the browser talks to the gateway directly — the interview is a live,
# turn-by-turn conversation, not a server-rendered page. NEXT_PUBLIC_* because it ships in the
# client bundle; the gateway's CORS is already scoped to PUBLIC_WEB_URL above, which defaults
# to this app's own origin. Voice (record -> transcribe -> fill-slot) still goes through this
# app's own /api/transcribe and /api/fill-slot routes server-side — audio never goes
# cross-origin, and the ai service has no CORS config of its own.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# ---- datastores (match docker-compose.yml) ----
# NOTE: container is on 5433 — a native Homebrew Postgres shadows 5432 on this machine
# Supabase (default): DATABASE_URL = the pooler URL (session mode, port 5432); DIRECT_URL = the direct
# connection (Prisma migrations need it). Dashboard -> Connect. Region should be Mumbai (ap-south-1).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Local / offline dev instead (docker compose Postgres): set BOTH to the same value —
#   DATABASE_URL=postgresql://careflow:careflow@localhost:5433/careflow
#   DIRECT_URL=postgresql://careflow:careflow@localhost:5433/careflow
REDIS_URL=redis://localhost:6379
# Storage: STORAGE_PROVIDER=supabase (default) or minio (local/offline). Both speak S3.
STORAGE_PROVIDER=supabase
S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# (older names S3_ACCESS_KEY / S3_SECRET_KEY are still read as a fallback — new setups use the two above)
# Local MinIO instead: STORAGE_PROVIDER=minio, S3_ENDPOINT=http://localhost:9000, S3_REGION=us-east-1,
#   S3_ACCESS_KEY_ID=careflow, S3_SECRET_ACCESS_KEY=careflow123
S3_BUCKET_DOCUMENTS=intake-documents
S3_BUCKET_AUDIO=intake-audio

# Supabase project (server-side only — never NEXT_PUBLIC_, never in a browser bundle)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The public HTTPS origin of the patient app. Token-slip QR codes encode this. `make tunnel` prints one;
# a phone's microphone only works on HTTPS (or localhost on the same device).
INTAKE_PUBLIC_URL=http://localhost:3030

# Printed at the top of every token slip.
HOSPITAL_NAME=CareFlow OPD

# ---- auth / crypto ----
JWT_SECRET=change-me-in-production
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key

# =============================================================
# SPEECH — PRIORITY 1. Needed for Day 2.
# Every provider has a local fallback; the demo must run offline.
# =============================================================

# ---- Sarvam (primary): streaming ASR + TTS + LLM, one key ----
# Saaras v3 STT ~Rs.30/hr · Bulbul v2 TTS ~Rs.15/10K chars
# Rs.100 free credits on signup ~= 3 hours of audio, enough for the whole build
SARVAM_API_KEY=
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix       # transcribe | translate | verbatim | translit | codemix
SARVAM_SAMPLE_RATE=16000      # MUST match the audio actually sent
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=

# ---- Bhashini (ULCA) — second cloud path + the government story ----
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ---- speech provider selection ----
ASR_PROVIDER=sarvam           # sarvam | bhashini | local
TTS_PROVIDER=sarvam           # sarvam | bhashini | local
TTS_CACHE_DIR=./.cache/tts    # the prompt set is finite — cache everything

# =============================================================
# LANGUAGE MODEL — PRIORITY 1
# Sarvam 30B/105B are Apache-2.0, so the API model and the
# on-premise model are the SAME model. That makes the
# data-residency claim testable, not rhetorical.
# =============================================================

LLM_PROVIDER=sarvam           # sarvam | openai | anthropic | google | local — "sarvam" gets
                               # automatic fallback to LLM_BASE_URL if unreachable (rule 9);
                               # "local" forces local-only (e.g. network-off rehearsal)
LLM_API_KEY=
LLM_SLOT_MODEL=sarvam-105b    # every turn — small, fast, owns the latency budget. sarvam-30b
                               # was deprecated by the provider; -105b/-conversations are the
                               # only models the API currently accepts
LLM_SUMMARY_MODEL=sarvam-105b # once per session
# ---- local LLM tier (offline fallback, no key needed) ----
# docs/15-ai-stack.md's "Language model — local tier reality check" has the full comparison and
# setup: `brew install ollama && brew services start ollama && ollama pull llama3.2:3b`, then
# the two vars below. Same OpenAI-compatible adapter as any other self-hosted server
# (services/ai/app/llm/openai_compatible.py) — Ollama just needs to be running and reachable.
LLM_BASE_URL=                 # set for local/self-hosted (e.g. http://localhost:11434/v1)
LLM_LOCAL_SLOT_MODEL=         # local tier's OWN model name (e.g. llama3.2:3b) — kept separate
                               # from LLM_SLOT_MODEL above: sarvam and a self-hosted Ollama
                               # server are different providers with different model catalogues

# ---- de-identification: strip PII before any hosted model call ----
DEID_ENABLED=true
DEID_STRICT=true              # true in production; false only for local debugging

# =============================================================
# DOCUMENT AI — PRIORITY 2. Needed for Day 3.
# Self-hosted, no key required. See docs/15-ai-stack.md
# =============================================================

OCR_PROVIDER=stub                        # hosted | local | stub — see docs/06-document-ai.md's
                                          # "OCR reality check" for what each tier actually is
OCR_MODEL=PaddlePaddle/PaddleOCR-VL       # Apache-2.0, ~2GB weights, the `local` tier — CPU-only
                                          # on this machine, unexercised so far, see that doc
OCR_DEVICE=auto                          # auto | cpu | cuda | mps
NER_MODEL=Ihor/gliner-biomed-base-v1.0   # zero-shot biomedical NER, CPU-usable — C2 work, not yet wired
DRUG_DICT_PATH=./infra/seed/allopathic-brands/indian_medicine_data.csv
# NOTE: RxNorm/openFDA are US vocabularies and will NOT contain Indian brand
# names (Dolo 650, Shelcal, Pan-D). Use the Indian datasets. And the NLM/RxNav
# Drug Interaction API is DISCONTINUED — see docs/15-ai-stack.md.
OPENFDA_API_KEY=                         # optional, for label warnings only
# docai's Celery worker can't emit document.processed itself — only the gateway owns the
# Socket.IO server — so it POSTs its result here and the gateway emits on its behalf.
GATEWAY_CALLBACK_URL=http://localhost:4000/v1/internal/documents/callback

# =============================================================
# ABDM / ABHA — PRIORITY 3. Mock gateway works without these.
# Sandbox registration takes days-to-weeks. Start it now, build on mock.
# =============================================================

ABDM_MODE=mock                # mock | sandbox | production
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
ABDM_CM_ID=sbx
ABDM_HIP_ID=

# ---- WHO ICD-11 API (free, OAuth2 client_credentials) ----
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
ICD_API_URL=https://id.who.int

# ---- NAMASTE export (services/terminology) ----
# Not an API key — a data-acquisition task (docs/API_KEYS.md priority 4). Path to the ORIGINAL
# export file from namaste.ayush.gov.in, read with pandas/openpyxl (never re-saved through a
# spreadsheet app first — codes like AAA-2.1 get mangled into dates). Empty until obtained.
NAMASTE_EXPORT_PATH=
# Multilingual sentence-embedding model bridging Devanagari/IAST/Latin spellings of the same
# concept for services/terminology's search (pg_trgm alone can't cross scripts) — see that
# service's README for what's actually verified to load on this machine.
EMBEDDING_MODEL=sentence-transformers/LaBSE

# =============================================================
# OFFLINE FALLBACKS — no key needed. The demo runs on these.
# =============================================================

LOCAL_ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual   # MIT, 22 languages
LOCAL_ASR_ENABLED=true
LOCAL_TTS_MODEL=ai4bharat/IndicF5
FHIR_SERVER_URL=http://localhost:8090/fhir
HIS_PUSH_URL=                             # empty = disabled; hospital's REST receiving endpoint for the signed FHIR bundle

# =============================================================
# CareFlow — copy to .env and fill in. NEVER commit .env
# See docs/API_KEYS.md for where each credential comes from.
# =============================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---- core services ----
GATEWAY_PORT=4000
AI_SERVICE_URL=http://localhost:8001
DOCAI_SERVICE_URL=http://localhost:8002
TERMINOLOGY_SERVICE_URL=http://localhost:8003
PUBLIC_WEB_URL=http://localhost:3000

# ---- datastores (match docker-compose.yml) ----
DATABASE_URL=postgresql://careflow:careflow@localhost:5432/careflow
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=careflow
S3_SECRET_KEY=careflow123
S3_BUCKET=careflow-documents

# ---- auth / crypto ----
JWT_SECRET=change-me-in-production
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key

# =============================================================
# EXTERNAL APIS — every one has a local fallback. See docs/API_KEYS.md
# =============================================================

# ---- Bhashini (ULCA) : ASR + TTS + translation. PRIORITY 1 ----
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ---- LLM provider (pluggable adapter) ----
LLM_PROVIDER=openai          # openai | anthropic | google | sarvam | local
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=                # set for local/self-hosted (e.g. http://localhost:8080/v1)

# ---- ABDM / ABHA. PRIORITY 2 — mock gateway works without these ----
ABDM_MODE=mock               # mock | sandbox | production
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
ABDM_CM_ID=sbx
ABDM_HIP_ID=

# ---- WHO ICD-11 API (free, OAuth2 client_credentials). PRIORITY 3 ----
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
ICD_API_URL=https://id.who.int

# ---- self-hosted fallbacks (no key needed) ----
LOCAL_ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
LOCAL_ASR_ENABLED=true
FHIR_SERVER_URL=http://localhost:8090/fhir

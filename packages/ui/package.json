{
  "name": "@careflow/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design system, two density modes: staff (apps/console) and patient signage (apps/intake). Tokens, Tailwind presets, and the safety-critical primitives CLAUDE.md's colour rules require. Consumed as TS/TSX source via each app's transpilePackages — no build step.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./tokens": "./src/tokens.ts",
    "./tailwind-preset-patient": "./src/tailwind-preset-patient.ts",
    "./tokens-patient": "./src/tokens-patient.ts",
    "./patient": "./src/patient.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'ui: no eslint config yet'"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "next": "^16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  }
}
